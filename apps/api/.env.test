# Test-only env — safe to commit (no real secrets, points only at the
# throwaway local Docker Compose Postgres/Redis). NEVER point this at a real
# database: the repo-root .env is wired to a remote VPS for local dev against
# the real stack, and tests must never touch that.
#
# Start the throwaway containers first: docker compose up -d postgres redis
NODE_ENV=development
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
REDIS_URL=redis://localhost:6379
JWT_SECRET=test_jwt_secret_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=test_refresh_secret_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
COOKIE_SECRET=test_cookie_secret_cccccccccccccccccccccccccccccccc

# A real (but disposable, never used for actual delivery) VAPID key pair —
# generated once via web-push's own generateVAPIDKeys(). push.service.ts's
# ensureVapid() requires structurally-valid keys before it will even attempt
# a send; tests always mock webpush.sendNotification itself, so these keys
# only need to satisfy web-push's own format validation, never a real service.
VAPID_PUBLIC_KEY=BJoqKvv0cPZb3Q5B_emFExqqab-tDkqqi0gOHQ_4ZHq9p69PpOasgOxybdwEO2vNkSZedOrnJXnlUdnIOTh0AAY
VAPID_PRIVATE_KEY=feWE_SpZIfyyM1-mtZsG1hXjkziT6oQXP_PaTS1YgQY
