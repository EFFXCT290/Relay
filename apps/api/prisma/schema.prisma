// Relay — unified schema (v1.0 + v1.1 addendum)
// Source of truth: Documentation/API_DOCUMENTATION.md + RELAY_API_ADDENDUM_v1.1.md
// v1.1 supersedes v1.0 for: Media model (quality/status), Read receipts, Last seen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
//  Identity
// ────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  username     String   @unique @db.VarChar(30)
  passwordHash String
  passwordSalt String   @db.Char(64) // 32 bytes hex
  // Avatar: stores the raw MinIO object key (never a signed URL — URLs expire,
  // keys don't). null = no custom avatar (clients fall back to the initials
  // gradient). The key embeds a random token so replacing an avatar yields a
  // fresh key, side-stepping CDN/browser caching of the previous image.
  avatarKey    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Web Push notification preferences. Two flat booleans for now; if categories
  // proliferate (mentions/reactions/announcements) migrate to a single
  // `notificationPreferences Json?` rather than adding more columns.
  pushMessages Boolean @default(true)
  pushCalls    Boolean @default(true)

  sentMessages      Message[]          @relation("SentMessages")
  conversations     Participant[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  uploadedMedia     Media[]
  reads             MessageRead[]
  reactions         Reaction[]
  presence          UserPresence?
  outgoingCalls     Call[]             @relation("OutgoingCalls")
  incomingCalls     Call[]             @relation("IncomingCalls")
  eventOutbox       EventOutbox[]
  spotifyConnection SpotifyConnection?
  pinnedMessages    PinnedMessage[]
  nicknamesGiven    UserNickname[]     @relation("NicknameOwner")
  nicknamesReceived UserNickname[]     @relation("NicknameTarget")

  @@index([username])
}

// Durable "last seen" history. The presence service is the SOLE writer of
// lastSeenAt and sets it explicitly (no @updatedAt) — so the timestamp can't be
// re-stamped by unrelated row updates. @default(now()) is an INSERT-only fallback
// for the NOT NULL column (never fires on UPDATE, so it can't re-stamp). isOnline
// is written best-effort for debugging but is NEVER read for status; online is
// derived from the Redis heartbeat key. See apps/api/src/modules/presence/.
model UserPresence {
  userId     String   @id
  lastSeenAt DateTime @default(now())
  isOnline   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────────────────────────────────
//  Conversations & messages
// ────────────────────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants   Participant[]
  messages       Message[]
  calls          Call[]
  eventOutbox    EventOutbox[]
  pinnedMessages PinnedMessage[]
}

model Participant {
  id             String    @id @default(uuid())
  userId         String
  conversationId String
  joinedAt       DateTime  @default(now())
  acceptedAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id              String      @id @default(uuid())
  conversationId  String
  senderId        String
  type            MessageType
  body            String?
  replyToId       String?
  isEdited        Boolean     @default(false)
  editedAt        DateTime?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  deliveredAt     DateTime?
  clientMessageId String? // client-generated UUID for idempotent sends
  createdAt       DateTime    @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("SentMessages", fields: [senderId], references: [id])
  replyTo      Message?            @relation("Replies", fields: [replyToId], references: [id])
  replies      Message[]           @relation("Replies")
  attachments  MessageAttachment[]
  reads        MessageRead[]
  reactions    Reaction[]
  embed        MessageEmbed?
  pinned       PinnedMessage?
  disappear    MessageDisappearState?

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ────────────────────────────────────────────────────────────────────────────
//  Disappearing messages — mirrors TemporaryMedia's shape and purpose exactly:
//  a sidecar row for an ephemeral thing with a view count or expiry that needs
//  sweeping. Only a message sent with disappear-on gets a row. VIEWS mode
//  hides the body until POST /messages/:id/view spends a look (Snapchat-style,
//  same as ephemeral media's POST /media/:id/view); TIME mode shows the body
//  immediately and the message expires itself later (Signal-style). The sweep
//  (cleanup.worker.ts) queries THIS table directly — never a filtered scan
//  across all messages — and soft-deletes the Message via the existing
//  isDeleted/deletedAt mechanism once a mode's condition is met; it never
//  hard-deletes. consumedAt is the single "done" marker (there is no separate
//  purge phase like TemporaryMedia's MinIO purge — soft-deleting a row has no
//  bytes to clean up), stamped once the Message has been soft-deleted so the
//  sweep never reprocesses an already-handled message.
// TIME mode's clock does not start at send — it starts the first time the
// recipient explicitly opens the message (POST /messages/:id/view). Before
// that, ttlSeconds holds the sender's chosen duration but expiresAt and
// firstOpenedAt both stay null, and the sweep's `expiresAt IS NOT NULL`
// filter means a never-opened message is never a sweep candidate — it waits
// indefinitely. Reopening after the first open is a no-op on the clock: the
// route only ever sets firstOpenedAt/expiresAt when firstOpenedAt is still
// null, so a second (or third...) explicit open just re-reads the same
// already-computed expiresAt rather than recomputing it.
model MessageDisappearState {
  id            String        @id @default(uuid())
  messageId     String        @unique
  mode          DisappearMode
  viewLimit     Int? // 1..5, required for mode VIEWS; null for TIME
  viewCount     Int           @default(0)
  ttlSeconds    Int? // TIME mode's chosen duration, persisted at send; null for VIEWS
  firstOpenedAt DateTime? // TIME mode: stamped on the recipient's first explicit open — starts the clock; null for VIEWS
  expiresAt     DateTime? // TIME mode: firstOpenedAt + ttlSeconds, computed once on first open; null until then, and always null for VIEWS
  consumedAt    DateTime? // stamped once the condition is met AND the Message has been soft-deleted
  createdAt     DateTime      @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([mode, consumedAt, expiresAt]) // sweep: TIME-mode candidates not yet consumed, already opened; VIEWS backstop
}

enum DisappearMode {
  VIEWS
  TIME
}

// One row per pinned message (max 3 per conversation, enforced in
// message.routes.ts at pin time — not expressible as a DB constraint since it
// requires a per-conversationId count, not a per-column uniqueness rule).
// messageId is unique: a message can only be pinned once. Both participants
// can pin/unpin any message, not just their own — pinnedBy just records who
// did it, for the "pinned by @username" display. Cascade on both
// conversationId and messageId: a soft-deleted message is unpinned explicitly
// by the DELETE /messages/:messageId route (soft-delete never fires FK
// cascades), but a hard-deleted conversation or message (e.g. via Prisma
// cleanup in tests) still needs the row gone with it.
model PinnedMessage {
  id             String   @id @default(uuid())
  conversationId String
  messageId      String   @unique
  pinnedBy       String
  pinnedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedByUser User         @relation(fields: [pinnedBy], references: [id], onDelete: Cascade)

  @@index([conversationId, pinnedAt])
}

model MessageEmbed {
  id          String   @id @default(uuid())
  messageId   String   @unique
  url         String
  title       String?
  description String?
  imageUrl    String?
  siteName    String?
  faviconUrl  String?
  type        String?
  provider    String?
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId]) // one reaction per user per message; second tap toggles
  @@index([messageId])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  readerId  String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reader  User    @relation(fields: [readerId], references: [id])

  @@unique([messageId, readerId])
  @@index([messageId])
  @@index([readerId])
}

// ────────────────────────────────────────────────────────────────────────────
//  Calls (Phase 6C — durable history; runtime state is ephemeral, see
//  apps/api/src/modules/calls/calls.runtime.ts)
// ────────────────────────────────────────────────────────────────────────────
// Calls are NOT messages and never live in the Message table. This table is the
// durable record only (missed/answered/duration/timestamps); active ringing/
// negotiation state is held in-memory. The row is created at call:init (status
// RINGING) so a missed call survives a crash/disconnect/refresh. durationSec
// counts CONNECTED media time — measured from the runtime answeredAt, never
// from startedAt. conversationId/endedByUserId are nullable and recorded now to
// avoid future migrations (call-again, in-conversation history, who-hung-up).

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ANSWERED
  MISSED
  REJECTED
  FAILED
  ENDED
}

model Call {
  id             String     @id @default(uuid())
  callerId       String
  recipientId    String
  conversationId String?
  type           CallType
  status         CallStatus @default(RINGING)
  startedAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int        @default(0)
  endedByUserId  String? // who ended/rejected; null = system (e.g. ring timeout)
  createdAt      DateTime   @default(now())

  caller       User          @relation("OutgoingCalls", fields: [callerId], references: [id], onDelete: Cascade)
  recipient    User          @relation("IncomingCalls", fields: [recipientId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([callerId, createdAt])
  @@index([recipientId, createdAt])
  @@index([conversationId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
//  Media (Phase 1 — upload-first, attach-to-message via MessageAttachment)
// ────────────────────────────────────────────────────────────────────────────

model Media {
  id               String  @id @default(cuid())
  uploaderId       String
  storageKey       String  @unique
  blurStorageKey   String?
  thumbStorageKey  String?
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  blurWidth        Int?
  blurHeight       Int?
  thumbWidth       Int?
  thumbHeight      Int?
  status           String  @default("ready") // "processing" | "ready" | "failed"
  clientUploadId   String? @unique // client-generated UUID for idempotent re-uploads
  // Voice-note fields (kind = "voice"). durationMs is supplied by the recorder.
  // transcript holds the structured Whisper result {segments,fullText,primaryLanguage};
  // transcriptStatus tracks the async transcription job independently of `status`.
  durationMs       Int?
  transcript       Json?
  transcriptStatus String? // "pending" | "ready" | "failed" (null for non-voice)

  // ── Phase 6B (video integration) ──────────────────────────────────────────
  // kind classifies the asset for routing the right pipeline; legacy rows are
  // null and treated as "image" by readers. deliveryMode is the user's choice
  // (or auto-promoted to LSS for HEVC/DNG); isLss mirrors it as a fast badge
  // flag. isHevcSource records the probed source codec for the auto-LSS rule.
  // Variants + tasks live in their own tables; manifest.json in MinIO remains
  // the canonical source of truth — these columns are denormalized for queries.
  kind         MediaKind? // null = legacy (pre-6B); reader defaults to image
  deliveryMode MediaDeliveryMode @default(OPTIMIZED)
  isLss        Boolean           @default(false)
  isHevcSource Boolean           @default(false)

  createdAt DateTime @default(now())

  uploader    User                  @relation(fields: [uploaderId], references: [id])
  attachments MessageAttachment[]
  variants    MediaVariant[]
  tasks       MediaProcessingTask[]
  temporary   TemporaryMedia?
}

// ────────────────────────────────────────────────────────────────────────────
//  Phase 6E — ephemeral / view-once media (Instagram-style, view-COUNT based)
// ────────────────────────────────────────────────────────────────────────────
// Sidecar on Media (1:1) that makes an attachment disappear after the recipient
// has opened it maxViews times. There is NO timer — expiry is a view count. Only
// ephemeral media gets a row; "unlimited" (normal) media has none. The server is
// the sole authority: it never serializes a URL for ephemeral media (the only URL
// is a short-lived one minted by POST /media/:id/view, which increments viewCount),
// and a background sweep purges the MinIO bytes once consumed.
model TemporaryMedia {
  id         String    @id @default(uuid())
  mediaId    String    @unique
  maxViews   Int // 1..5 ("view once" = 1); unlimited media gets no row
  viewCount  Int       @default(0)
  consumedAt DateTime? // stamped when viewCount reaches maxViews
  purgedAt   DateTime? // stamped after MinIO bytes removed by the sweep
  createdAt  DateTime  @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([consumedAt, purgedAt]) // sweep: consumed && not yet purged
}

// ────────────────────────────────────────────────────────────────────────────
//  Phase 6B — normalized variant + processing-task model
// ────────────────────────────────────────────────────────────────────────────
// Replaces per-derivative status columns on Media. Each generated rendition is
// a MediaVariant row (one per type), and each async unit of work is a
// MediaProcessingTask row with its own state machine. Workers are stateless:
// they derive every storage key from (mediaId, type) and write results here +
// into the manifest.

enum MediaKind {
  IMAGE
  VIDEO
  VOICE
}

enum MediaDeliveryMode {
  OPTIMIZED
  LSS
}

enum MediaVariantType {
  ORIGINAL
  OPTIMIZED // image display webp/avif, or video streaming mp4
  POSTER // video poster frame
  PREVIEW // animated video preview
  THUMBNAIL // sm/md/lg chat-list thumbs (label distinguishes size)
  WAVEFORM // voice waveform json
}

enum MediaTaskType {
  TRANSCODE
  THUMBNAIL
  POSTER
  WAVEFORM
  TRANSCRIPT
}

enum MediaTaskState {
  PENDING
  PROCESSING
  READY
  FAILED
}

model MediaVariant {
  id         String           @id @default(cuid())
  mediaId    String
  type       MediaVariantType
  label      String           @default("") // disambiguates same-type variants (thumb_sm/md/lg, stream_720p); "" for singletons
  storageKey String           @unique
  mimeType   String
  codec      String?
  width      Int?
  height     Int?
  bitrate    Int? // bits/sec, video only
  sizeBytes  Int?
  createdAt  DateTime         @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, type, label])
  @@index([mediaId])
}

model MediaProcessingTask {
  id        String         @id @default(cuid())
  mediaId   String
  type      MediaTaskType
  state     MediaTaskState @default(PENDING)
  attempts  Int            @default(0)
  error     String? // last failure detail, truncated
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, type])
  @@index([mediaId])
  @@index([state])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  mediaId   String
  type      String // "image"
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id])

  @@index([messageId])
}

// ────────────────────────────────────────────────────────────────────────────
//  Notifications & auth blocklist
// ────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  payload   Json
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

enum NotificationType {
  SYSTEM_ALERT
  MESSAGE_RECEIVED
  NICKNAME_SHARED
}

// One row per installed device/browser (a user can have many). We store the
// FULL raw browser PushSubscription as JSON and hand it straight to web-push —
// future-proof against providers adding fields. `endpoint` is denormalized out
// for dedup + indexing. No provider-host allowlist (maintenance debt): subscribe
// only validates https + length, and dead endpoints are pruned reactively when a
// send returns 404/410. lastUsedAt is bumped on every successful send AND on
// (re)subscribe, so a valid device that simply never received a push isn't aged
// out by the 180-day backstop sweep.
model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  endpoint     String   @unique
  subscription Json
  userAgent    String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
//  Spotify "recently played" profile badge
// ────────────────────────────────────────────────────────────────────────────
// One row per connected user (1:1, keyed by userId — same shape as UserPresence).
// accessToken/refreshToken are ciphertext (AES-256-GCM via SPOTIFY_TOKEN_ENC_KEY,
// see backend-core/crypto/token-cipher.ts); the decryption key lives ONLY in env,
// never in this table, so a DB dump alone can't recover a usable token. scope
// records what Spotify actually granted (it can differ from what was requested).
// needsReconnect is set when a refresh_token exchange fails (e.g. the user
// revoked access on Spotify's side) so the badge endpoint can stop retrying a
// doomed refresh on every profile view and instead prompt the user to
// reconnect; it's cleared the next time /spotify/connect completes.
model SpotifyConnection {
  userId         String   @id
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  scope          String
  showOnProfile  Boolean  @default(true)
  needsReconnect Boolean  @default(false)
  connectedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JtiBlocklist {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────────────────
//  Realtime event outbox (Phase 4.3 reconnect replay)
// ────────────────────────────────────────────────────────────────────────────
// One row per (event, recipient). Rows are written before socket emit so no
// event can be lost between "sent" and "recorded". ackedAt is stamped when
// the recipient confirms delivery; only null-ackedAt rows appear in replay.
// Cleanup of old acked rows is a background job (separate from this schema).
model EventOutbox {
  id             String    @id @default(uuid())
  eventId        String    @unique
  eventName      String
  conversationId String? // scopes replay to a single thread; null = user-global event
  payload        Json
  recipientId    String
  createdAt      DateTime  @default(now())
  ackedAt        DateTime?

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recipient    User          @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // id tiebreaks millisecond collisions → deterministic replay order under burst load.
  @@index([recipientId, ackedAt, createdAt, id])
  // Postgres doesn't auto-index FK columns (unlike MySQL) — without this, a
  // conversation delete cascading into EventOutbox would sequentially scan
  // the whole table to find matching rows.
  @@index([conversationId])
}

// Private, per-owner nicknames for a conversation partner. Two named relations
// to User since both FKs point at the same model. Private by default
// (sharedWithTarget: false) — a nickname override must never leak past its
// owner unless they explicitly turn sharing on (see nickname.routes.ts).
model UserNickname {
  id               String   @id @default(uuid())
  ownerId          String
  targetUserId     String
  nickname         String
  sharedWithTarget Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner  User @relation("NicknameOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  target User @relation("NicknameTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, targetUserId])
  // Postgres doesn't auto-index FK columns — without this, resolving "who has
  // shared a nickname with ME" (the target-side lookup) would sequentially
  // scan the whole table.
  @@index([targetUserId])
}
