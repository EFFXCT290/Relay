# VPS-only credentials for docker-compose.vps.yml's ${VAR} substitution.
# Copy to .env.vps and fill in the real values — .env.vps is git-ignored,
# unlike this template. Build/run with:
#   docker compose --env-file .env.vps -f docker-compose.vps.yml up -d

# Password for the existing postgres container's "relay" user.
POSTGRES_PASSWORD=

# Leave blank if the existing redis container has no requirepass configured.
REDIS_PASSWORD=

# Dev-scoped MinIO credentials for docker-compose.vps.test.yml — explicit here
# rather than relying on whatever env_file: .env resolves to on the machine
# that actually runs the test, since that file's contents can differ by host.
MINIO_ACCESS_KEY_TEST=your_dev_minio_access_key
MINIO_SECRET_KEY_TEST=your_dev_minio_secret_key
MINIO_BUCKET_MEDIA_TEST=relay-media-dev
